<Window x:Class="WeatherScope.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WeatherScope.Controls"
        xmlns:conv="clr-namespace:WeatherScope.Converters"
        Title="WeatherScope — цифровая метеостанция"
        Width="1280" Height="860" MinWidth="900" MinHeight="640"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVisible" />
    <conv:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True" />
    <conv:NullToVisibilityConverter x:Key="NullToVisible" />
    <conv:NullToVisibilityConverter x:Key="NullToCollapsed" Invert="True" />
    <conv:ColorToBrushConverter x:Key="ColorToBrush" />
    <conv:AlphaBrushConverter x:Key="AlphaBrush" />
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Grid.RowSpan="4" x:Name="ParticleLayer" IsHitTestVisible="False" Panel.ZIndex="0">
      <c:ParticleSystemControl x:Name="Particles" />
    </Grid>

    <Grid Grid.Row="0" Margin="24,20,24,4" Panel.ZIndex="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="WeatherScope" FontSize="22" FontWeight="Bold"
                   Foreground="{Binding AccentBrush}" />
        <TextBlock Text="  метеостанция" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,3"
                   Foreground="{StaticResource TextMutedBrush}" />
      </StackPanel>

      <Grid Grid.Column="1" Margin="32,0" MaxWidth="420" HorizontalAlignment="Center">
        <TextBox x:Name="SearchBox"
                 Style="{StaticResource SearchBox}"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Поиск города"
                 ToolTip="Введите название города"
                 KeyDown="SearchBox_KeyDown"
                 GotKeyboardFocus="SearchBox_GotKeyboardFocus" />
        <Popup IsOpen="{Binding IsSearchOpen, Mode=OneWay}"
               PlacementTarget="{Binding ElementName=SearchBox}"
               Placement="Bottom" StaysOpen="True" AllowsTransparency="True"
               Width="{Binding ActualWidth, ElementName=SearchBox}">
          <ListBox x:Name="CityList"
                   Style="{StaticResource CityListBox}"
                   ItemsSource="{Binding Suggestions}"
                   SelectionChanged="CityList_SelectionChanged"
                   Margin="0,4,0,0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{StaticResource TextBrush}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Popup>
      </Grid>

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,16,0"
                   Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
        <Button Content="Обновить"
                Style="{StaticResource AccentButton}"
                Background="{Binding AccentBrush}"
                Command="{Binding RefreshCommand}"
                AutomationProperties.Name="Обновить данные о погоде" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Margin="32,8,32,0" Padding="14,10" CornerRadius="10"
            Background="#33FF4757" BorderBrush="#FF4757" BorderThickness="1"
            Panel.ZIndex="2"
            Visibility="{Binding HasError, Converter={StaticResource BoolToVisible}}">
      <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource BodyText}"
                 AutomationProperties.LiveSetting="Assertive" />
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Panel.ZIndex="1"
                  Padding="16,8,16,8">
      <Grid>
        <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="260" />
            <RowDefinition Height="260" />
            <RowDefinition Height="220" />
          </Grid.RowDefinitions>
          <c:ShimmerControl Grid.Column="0" Margin="8" />
          <c:ShimmerControl Grid.Column="1" Margin="8" />
          <c:ShimmerControl Grid.Column="2" Margin="8" />
          <c:ShimmerControl Grid.Row="1" Grid.Column="0" Margin="8" />
          <c:ShimmerControl Grid.Row="1" Grid.Column="1" Margin="8" />
          <c:ShimmerControl Grid.Row="1" Grid.Column="2" Margin="8" />
          <c:ShimmerControl Grid.Row="2" Grid.ColumnSpan="3" Margin="8" />
        </Grid>

        <Grid DataContext="{Binding Snapshot}"
              Visibility="{Binding DataContext.HasSnapshot, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisible}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="СЕЙЧАС" Style="{StaticResource TitleText}" />
                <TextBlock Text="{Binding TempText}" FontSize="72" FontWeight="Bold"
                           Foreground="{Binding Accent, Converter={StaticResource ColorToBrush}}"
                           AutomationProperties.Name="Температура" />
                <TextBlock Text="{Binding ConditionText}" FontSize="18" Foreground="{StaticResource TextBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding FeelsLikeText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
              </StackPanel>
              <c:ThermometerControl Grid.Column="1" Width="90" Height="230" Margin="12,0,0,0"
                                    Temperature="{Binding Temp}"
                                    FeelsLike="{Binding FeelsLike}"
                                    AccentColor="{Binding Accent}" />
            </Grid>
          </Border>

          <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="ВЕТЕР" Style="{StaticResource TitleText}" />
              <TextBlock DockPanel.Dock="Bottom" Text="{Binding WindDirText, StringFormat='Направление: {0}'}"
                         Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,6,0,0" />
              <c:CompassControl Height="210" HorizontalAlignment="Center"
                                WindSpeed="{Binding WindSpeed}"
                                WindGust="{Binding WindGust}"
                                ArrowDegrees="{Binding WindArrowDegrees}"
                                IsCalm="{Binding WindCalm}"
                                AccentColor="{Binding Accent}"
                                AutomationProperties.Name="Компас направления ветра" />
            </DockPanel>
          </Border>

          <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="ДАВЛЕНИЕ" Style="{StaticResource TitleText}" />
              <c:BarometerControl Height="240" HorizontalAlignment="Center"
                                  Pressure="{Binding Pressure}"
                                  TrendText="{Binding PressureTrendText}"
                                  AccentColor="{Binding Accent}"
                                  AutomationProperties.Name="Барометр" />
            </DockPanel>
          </Border>

          <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="ПОЧАСОВОЙ ПРОГНОЗ НА 24 ЧАСА" Style="{StaticResource TitleText}" />
              <TextBlock DockPanel.Dock="Bottom" Text="{Binding PrecipitationOutlook}"
                         Style="{StaticResource MutedText}" Margin="0,8,0,0" />
              <c:HourlyChartControl Height="230"
                                    Points="{Binding Hourly}"
                                    AccentColor="{Binding Accent}"
                                    AutomationProperties.Name="График температуры по часам" />
            </DockPanel>
          </Border>

          <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource CardStyle}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="УЛЬТРАФИОЛЕТ" Style="{StaticResource TitleText}" />
              <c:UvArcControl Height="240"
                              UvIndex="{Binding UvIndex}"
                              Label="{Binding UvLabel}"
                              Advice="{Binding UvAdvice}"
                              AccentColor="{Binding Accent}"
                              AutomationProperties.Name="Индекс ультрафиолета" />
            </DockPanel>
          </Border>

          <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CardStyle}"
                  BorderBrush="{Binding Accent, Converter={StaticResource ColorToBrush}}">
            <StackPanel>
              <TextBlock Text="СОВЕТ ДНЯ" Style="{StaticResource TitleText}" />
              <TextBlock Text="{Binding SmartTip}" FontSize="20" FontWeight="SemiBold"
                         Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                         AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Border>

          <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="ПРОГНОЗ НА 7 ДНЕЙ" Style="{StaticResource TitleText}" />
              <ItemsControl ItemsSource="{Binding Daily}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,5">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="80" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding DayLabel}" Style="{StaticResource BodyText}" />
                      <TextBlock Grid.Column="1" Text="{Binding ConditionText}" Style="{StaticResource MutedText}"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding DayTemp}" Style="{StaticResource BodyText}"
                                 FontWeight="SemiBold" HorizontalAlignment="Right" />
                      <TextBlock Grid.Column="3" Text="{Binding NightTemp}" Style="{StaticResource MutedText}"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Text="{Binding Precipitation}" Style="{StaticResource MutedText}"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="5" Text="{Binding Wind}" Style="{StaticResource MutedText}"
                                 HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
          </Border>

          <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource CardStyle}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="ПОДРОБНОСТИ" Style="{StaticResource TitleText}" />
              <ItemsControl ItemsSource="{Binding Details}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,4">
                      <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" />
                      <TextBlock Text="{Binding Value}" Style="{StaticResource BodyText}"
                                 HorizontalAlignment="Right" FontWeight="SemiBold" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>
    </ScrollViewer>

    <TextBlock Grid.Row="3" Margin="32,4,32,10" Panel.ZIndex="2"
               Text="Данные: Яндекс Погода. Автообновление каждые 10 минут."
               Style="{StaticResource MutedText}" />
  </Grid>
</Window>
